{
  "name": "lucid",
  "private": true,
  "description": "Lucid development entry points: API (uvicorn, reload) + web (Vite).",
  "scripts": {
    "dev": "npm run dev:db && npm run dev:prepare && concurrently --kill-others --names api,web --prefix-colors yellow,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:prepare": "node tools/uv.mjs sync && node tools/uv.mjs run alembic upgrade head",
    "dev:api": "node tools/uv.mjs run uvicorn lucid.main:app --reload --port 8000",
    "dev:web": "npm --prefix frontend run dev",
    "dev:db": "docker compose up -d db",
    "dev:stack": "docker compose --profile full up -d --build",
    "dev:stack:down": "docker compose --profile full down",
    "demo:media": "npm --prefix frontend run demo:media",
    "trace:backend:evidence": "node tools/uv.mjs run pytest tests/unit --cov=lucid --cov-report=lcov:reports/lcov.info --cov-fail-under=0 --junitxml=reports/junit.xml",
    "trace:frontend:evidence": "cd frontend && npx vitest run --reporter=junit --outputFile=test-results/junit.xml --coverage --coverage.reporter=lcov",
    "trace": "node ../../trace-docs/dist/cli/index.js",
    "trace:check": "node ../../trace-docs/dist/cli/index.js check",
    "trace:changes": "node ../../trace-docs/dist/cli/index.js changes",
    "trace:evidence": "npm run trace:backend:evidence && npm run trace:frontend:evidence",
    "trace:verify": "node ../../trace-docs/dist/cli/index.js verify"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
