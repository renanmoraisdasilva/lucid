# Copy to .env and fill in real values. Never commit .env.

# Backend
DATABASE_URL=postgresql+asyncpg://lucid:lucid@localhost:5432/lucid
LOG_LEVEL=INFO
APP_ENV=local

# Provider: "gemini" (needs a key) or "fake" (scripted, offline)
PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=2048
