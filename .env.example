# Copy to .env and fill in real values. Never commit .env.
# Every setting has a default in backend/src/lucid/config.py; this file documents
# the ones worth overriding.

# Backend
DATABASE_URL=postgresql+asyncpg://lucid:lucid@localhost:5432/lucid
LOG_LEVEL=INFO
APP_ENV=local

# Default provider: "openai_compatible", "gemini" or "fake".
PROVIDER=openai_compatible

# OpenAI-compatible endpoint: Groq, Cerebras, OpenRouter, Ollama, ...
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
# Either name is accepted; GROQ_API_KEY also works.
OPENAI_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# Optional; defaults to the first listed model.

# Gemini (still supported; the picker lists it when a key is present)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=low

# Generation limits
GENERATION_TIMEOUT_SECONDS=60
GENERATION_MAX_OUTPUT_TOKENS=2048
# Abort a call that produces no text within this window (seconds).
GENERATION_FIRST_TOKEN_TIMEOUT_SECONDS=50

# Context budget (tokens). Groq's free tier allows 8K TPM, so keep this small.
CONTEXT_MAX_INPUT_TOKENS=6000
CONTEXT_RESERVED_OUTPUT_TOKENS=2048
CONTEXT_SAFETY_MARGIN_TOKENS=512
CONTEXT_MAX_MESSAGES=60

# Bounded retries for transient provider failures
GENERATION_MAX_RETRIES=2
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=8000
RETRY_JITTER=true

# Startup recovery for attempts stranded by a crash
RECONCILE_ON_STARTUP=true

# Dashboard estimated cost (USD per 1M tokens). Leave the rates commented to show
# the estimate as unavailable. These are example list prices, not billing data.
# PRICING_INPUT_USD_PER_MILLION=0.30
# PRICING_OUTPUT_USD_PER_MILLION=2.50
PRICING_FREE_TIER=true

# Telemetry retention. Conversation history is never deleted by cleanup.
TELEMETRY_RETENTION_DAYS=30
